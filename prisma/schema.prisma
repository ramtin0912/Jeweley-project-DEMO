// Prisma schema — Persian handmade jewelry store
// Prices are Toman integers (never floats). Dates stored UTC, displayed Shamsi.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

model Category {
  id        Int       @id @default(autoincrement())
  nameFa    String    @map("name_fa")
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id             Int              @id @default(autoincrement())
  categoryId     Int?             @map("category_id")
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  nameFa         String           @map("name_fa")
  slug           String           @unique
  descriptionFa  String?          @map("description_fa")
  priceToman     Int              @map("price_toman")
  material       String?
  weightGrams    Float?           @map("weight_grams")
  image          String? // single image for now (gallery later)
  status         ProductStatus    @default(ACTIVE)
  stockCount     Int              @default(0) @map("stock_count")
  isExclusive    Boolean          @default(false) @map("is_exclusive")
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  variants       ProductVariant[]
  packageItems   PackageItem[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id              Int            @id @default(autoincrement())
  productId       Int            @map("product_id")
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String // e.g. "سایز" or "طول زنجیر"
  value           String // e.g. "۱۶" or "۴۵ سانتی‌متر"
  priceDeltaToman Int            @default(0) @map("price_delta_toman")
  stockCount      Int            @default(0) @map("stock_count")
  packageItems    PackageItem[]

  @@index([productId])
  @@map("product_variants")
}

model Package {
  id             Int           @id @default(autoincrement())
  nameFa         String        @map("name_fa")
  slug           String        @unique
  descriptionFa  String?       @map("description_fa")
  priceToman     Int           @map("price_toman")
  image          String?
  status         ProductStatus @default(ACTIVE)
  stockCount     Int           @default(0) @map("stock_count")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  items          PackageItem[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("packages")
}

model PackageItem {
  id        Int             @id @default(autoincrement())
  packageId Int             @map("package_id")
  package   Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId Int             @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?            @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)

  @@index([packageId])
  @@map("package_items")
}

model PortfolioWork {
  id            Int      @id @default(autoincrement())
  titleFa       String   @map("title_fa")
  descriptionFa String?  @map("description_fa")
  image         String?
  material      String?
  year          Int?
  isFeatured    Boolean  @default(false) @map("is_featured")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("portfolio_works")
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique @map("order_number")
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  province      String
  city          String
  address       String
  postalCode    String?     @map("postal_code")
  status        OrderStatus @default(PENDING)
  totalToman    Int         @map("total_toman")
  authority     String? // Zarinpal authority
  refId         String?     @map("ref_id") // Zarinpal ref_id on success
  paidAt        DateTime?   @map("paid_at")
  items         OrderItem[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType     String  @map("item_type") // "product" | "package"
  itemId       Int     @map("item_id")
  nameFa       String  @map("name_fa") // snapshot at purchase time
  priceToman   Int     @map("price_toman") // snapshot at purchase time
  quantity     Int     @default(1)
  variantId    Int?    @map("variant_id")
  variantLabel String? @map("variant_label")

  @@index([orderId])
  @@map("order_items")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Post {
  id             Int       @id @default(autoincrement())
  titleFa        String    @map("title_fa")
  slug           String    @unique
  contentMd      String    @map("content_md")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  published      Boolean   @default(false)
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("posts")
}
