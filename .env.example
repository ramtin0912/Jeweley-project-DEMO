# ---------------------------------------------------------------------------
# Copy this to .env and fill in. NEVER commit .env (it's in .gitignore).
#
# DEMO_MODE controls the public read-only demo. When true:
#   - the admin panel is read-only (all /api/admin/** writes are blocked server-side)
#   - visitors can log in to the dashboard/finance/orders/catalog snapshot but
#     cannot change products, packages, posts, orders, or uploads
#   - the bundled DemoBanner shows on the storefront and in the admin
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Local dev: npx prisma dev prints a URL like
#   postgres://postgres:postgres@localhost:PORT/template1
# Change the db name to jewelry_store, e.g.:
#   postgres://postgres:postgres@localhost:51214/jewelry_store?sslmode=disable
#
# Production (Vercel + Neon, or Render Postgres, etc.): use the provider URL,
# always with sslmode=require in the demo.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jewelry_store?schema=public"
SHADOW_DATABASE_URL=""

# --- Payment (Zarinpal) ----------------------------------------------------
# Sandbox only needs any 36-char UUID merchant id.
ZARINPAL_MERCHANT_ID=""
# true = sandbox (test), false = live
ZARINPAL_SANDBOX="true"
# Demo mode: checkout skips Zarinpal and marks the order paid instantly.
# Keep true for the public demo so visitors can complete a checkout end-to-end.
DEMO_PAYMENT=true

# --- SMS OTP (Kavenegar) ---------------------------------------------------
# Leave empty in the demo: the OTP code is printed to the server console / a
# dev fallback token is returned (so visitors can still complete checkout).
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE="orderverify"

# --- Admin / Session -------------------------------------------------------
# Signing secret for the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
# The admin password used by the seed. Set BEFORE running the seed.
# For the public demo set a value you are happy to share publicly (read-only!).
ADMIN_PASSWORD=""

# --- Public demo flags -----------------------------------------------------
# Set DEMO_MODE=true on the public demo deployment (enables read-only admin +
# demo banner). Leave false/blank for private/production admin use.
DEMO_MODE=false
# Shown on the admin login page so visitors know the demo credentials.
# Username (default admin) and password (set this to the same value as
# ADMIN_PASSWORD to display it publicly — safe because the panel is read-only).
DEMO_ADMIN_USER="admin"
DEMO_ADMIN_PASSWORD=""
